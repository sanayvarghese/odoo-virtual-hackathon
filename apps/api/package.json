{
  "name": "@brightloop/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:create": "node scripts/create-db.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:views": "tsx src/db/migrate-views.ts",
    "seed": "tsx src/seed/seed.ts",
    "seed:fresh": "tsx src/seed/seed.ts --fresh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@node-rs/argon2": "^2.0.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "pg": "^8.16.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
