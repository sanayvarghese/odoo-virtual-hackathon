# ── Brightloop API environment ──────────────────────────────
# Copy to apps/api/.env and adjust. Defaults work offline.

PORT=4000
DATABASE_URL=postgres://postgres:root@localhost:5432/brightloop
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000          # where email links point
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M

# ── Real email (optional) ───────────────────────────────────
# Without these, verification/reset emails land in the dev mailbox (/mailbox).
# With them, the SAME links go out as real email. Gmail recipe:
#   1. Enable 2-Step Verification on the Google account
#   2. Create an App Password (myaccount.google.com → Security → App passwords)
#   3. Fill the four lines below (MAIL_FROM should be the same Gmail address —
#      Gmail rewrites the From header to the authenticated account anyway)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=Brightloop <you@gmail.com>

# Brevo (free 300/day) instead of Gmail:
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#   SMTP_USER=your_brevo_login       SMTP_PASS=your_smtp_key
